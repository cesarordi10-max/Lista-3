#include <iostream>

void intercambiar(int &a, int &b) {
    int temp = a;
    a = b;
    b = temp;
}

int main() {
    int x, y;
    std::cout << "Ingrese el valor de X: ";
    std::cin >> x;
    std::cout << "Ingrese el valor de Y: ";
    std::cin >> y;

    intercambiar(x, y);

    std::cout << "Valores intercambiados:\n";
    std::cout << "X: " << x << "\nY: " << y << std::endl;
    return 0;
}
