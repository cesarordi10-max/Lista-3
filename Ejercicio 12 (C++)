#include <iostream>
#include <fstream>
#include <string>

int main() {
    std::ifstream archivo("estudiantes.txt");
    if (!archivo.is_open()) {
        std::cerr << "No se pudo abrir el archivo estudiantes.txt\n";
        return 1;
    }

    std::string nombre;
    double nota;
    double suma = 0.0;
    int contador = 0;

    std::cout << "Leyendo datos de estudiantes.txt:\n";
    while (archivo >> nombre >> nota) {
        std::cout << "Estudiante: " << nombre << " | Nota: " << nota << "\n";
        suma += nota;
        contador++;
    }

    archivo.close();

    if (contador > 0) {
        std::cout << "\nPromedio general de la clase: " << (suma / contador) << std::endl;
    } else {
        std::cout << "No se encontraron datos válidos.\n";
    }

    return 0;
}
