#include <iostream>
#include <string>

void bubbleSortCadena(std::string &str) {
    int n = str.length();
    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(str[j] > str[j+1]) {
                char temp = str[j];
                str[j] = str[j+1];
                str[j+1] = temp;
            }
        }
    }
}

int main() {
    std::string cadena;
    std::cout << "Ingrese una cadena de caracteres: ";
    std::cin >> cadena;

    bubbleSortCadena(cadena);

    std::cout << "Cadena ordenada alfabéticamente: " << cadena << std::endl;
    return 0;
}
