#include <iostream>
#include <vector>

void ordenarVector(std::vector<int> &vec) {
    int n = vec.size();
    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(vec[j] > vec[j+1]) {
                int temp = vec[j];
                vec[j] = vec[j+1];
                vec[j+1] = temp;
            }
        }
    }
}

void imprimirVector(const std::vector<int> &vec) {
    for(int val : vec) {
        std::cout << val << " ";
    }
    std::cout << std::endl;
}

int main() {
    int n;
    std::cout << "Ingrese la cantidad de elementos: ";
    std::cin >> n;

    std::vector<int> vec(n);
    std::cout << "Ingrese los elementos:\n";
    for(int i = 0; i < n; i++) std::cin >> vec[i];

    ordenarVector(vec);
    
    std::cout << "Vector ordenado:\n";
    imprimirVector(vec);

    return 0;
}
