#include <iostream>
#include <vector>

int main() {
    int n;
    std::cout << "Ingrese el tamaño n de la matriz identidad: ";
    std::cin >> n;

    std::vector<std::vector<int>> matriz(n, std::vector<int>(n, 0));

    for(int i = 0; i < n; i++) {
        matriz[i][i] = 1;
    }

    std::cout << "Matriz Identidad:\n";
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            std::cout << matriz[i][j] << " ";
        }
        std::cout << "\n";
    }
    return 0;
}
