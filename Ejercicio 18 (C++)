#include <iostream>

int main() {
    int filas, columnas;
    std::cout << "Ingrese el número de filas y columnas: ";
    std::cin >> filas >> columnas;

    // Crear la matriz dinámica con doble puntero (int**)
    int** matriz = new int*[filas];
    for(int i = 0; i < filas; i++) {
        matriz[i] = new int[columnas];
    }

    std::cout << "Ingrese los valores de la matriz:\n";
    for(int i = 0; i < filas; i++) {
        for(int j = 0; j < columnas; j++) {
            std::cin >> matriz[i][j];
        }
    }

    std::cout << "\nMostrando la matriz dinámica:\n";
    for(int i = 0; i < filas; i++) {
        for(int j = 0; j < columnas; j++) {
            std::cout << matriz[i][j] << " ";
        }
        std::cout << "\n";
    }

    // Liberación de memoria dinámica correctamente
    for(int i = 0; i < filas; i++) {
        delete[] matriz[i];
    }
    delete[] matriz;
    matriz = nullptr;

    return 0;
}
