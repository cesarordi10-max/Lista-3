#include <iostream>
#include <vector>

int main() {
    int n, m;
    std::cout << "Ingrese filas (n) y columnas (m): ";
    std::cin >> n >> m;

    std::vector<std::vector<int>> matriz(n, std::vector<int>(m));
    std::vector<std::vector<int>> transpuesta(m, std::vector<int>(n));

    std::cout << "Ingrese los elementos de la matriz:\n";
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            std::cin >> matriz[i][j];
        }
    }

    // Proceso de transposición
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            transpuesta[j][i] = matriz[i][j];
        }
    }

    std::cout << "\nMatriz Transpuesta:\n";
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            std::cout << transpuesta[i][j] << " ";
        }
        std::cout << "\n";
    }
    return 0;
}
