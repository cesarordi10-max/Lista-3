#include <iostream>
#include <vector>

int main() {
    int n, suma = 0;
    std::cout << "Ingrese la cantidad de elementos: ";
    std::cin >> n;

    std::vector<int> vector(n);
    std::cout << "Ingrese los elementos del vector:\n";
    for(int i = 0; i < n; i++) {
        std::cin >> vector[i];
        suma += vector[i];
    }

    std::cout << "La suma total es: " << suma << std::endl;
    return 0;
