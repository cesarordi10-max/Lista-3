#include <iostream>
#include <vector>

int main() {
    int n;
    std::cout << "Ingrese el tamaño n de las matrices cuadradas: ";
    std::cin >> n;

    std::vector<std::vector<int>> A(n, std::vector<int>(n));
    std::vector<std::vector<int>> B(n, std::vector<int>(n));
    std::vector<std::vector<int>> C(n, std::vector<int>(n, 0));

    std::cout << "Ingrese elementos de la Matriz A:\n";
    for(int i = 0; i < n; i++)
        for(int j = 0; j < n; j++) std::cin >> A[i][j];

    std::cout << "Ingrese elementos de la Matriz B:\n";
    for(int i = 0; i < n; i++)
        for(int j = 0; j < n; j++) std::cin >> B[i][j];

    // Algoritmo de multiplicación
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            for(int k = 0; k < n; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    std::cout << "Matriz Resultante C = A * B:\n";
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            std::cout << C[i][j] << " ";
        }
        std::cout << "\n";
    }
    return 0;
}
