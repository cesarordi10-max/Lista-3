#include <iostream>

// Utilizando el algoritmo de Euclides
int obtenerMCD(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    int num1, num2;
    std::cout << "Ingrese dos números enteros: ";
    std::cin >> num1 >> num2;

    std::cout << "El MCD de " << num1 << " y " << num2 << " es: " << obtenerMCD(num1, num2) << std::endl;
    return 0;
}
